    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-PlataformaCreditos-2e877d62-2e57-4d48-9090-701ba1ead015</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
